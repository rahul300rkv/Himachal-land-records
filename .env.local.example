# ---------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local`.
#
# With NO Supabase variables set the app runs in DEMO MODE: search, records, the
# marketplace and PDF reports work on fictional sample data. Sign-in, the dashboard and
# creating listings need a connected Supabase project.
# ---------------------------------------------------------------

# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Bypasses Row Level Security. NEVER expose it to the browser and never
# prefix it with NEXT_PUBLIC_. Used to store generated reports so they appear on the
# dashboard and can be downloaded again. Without it, reports still download as PDFs but
# are not saved.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
